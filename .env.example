# ============================================================
# Venica Report System — 環境変数設定例
# このファイルを .env にコピーして各値を設定してください
# .env は絶対にGitにコミットしないでください
# ============================================================

# --- Shopify ---
SHOPIFY_SHOP_DOMAIN=your-shop-name.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

# --- OPENLOGI ---
OPENLOGI_API_KEY=your_openlogi_api_key
OPENLOGI_WAREHOUSE_ID=your_warehouse_id

# --- Google Cloud (サービスアカウント) ---
# サービスアカウントのJSONキーをBase64エンコードした文字列
# python -c "import base64; print(base64.b64encode(open('service_account.json','rb').read()).decode())"
GOOGLE_SERVICE_ACCOUNT_JSON_B64=eyJ0eXBlIjoic2Vydmljx...

# --- Google Sheets ---
# Google SheetsのスプレッドシートID（URLの /d/ と /edit の間の文字列）
GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# --- Gmail ---
# 送信元メールアドレス（サービスアカウントに委任されたアドレス）
GMAIL_SENDER=report@your-domain.com
# 送信先メールアドレス（カンマ区切りで複数指定可）
GMAIL_RECIPIENTS=president@your-domain.com,manager@your-domain.com

# --- Claude API (AIコメント生成用・オプション) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- レポート設定 ---
# 在庫アラートの閾値（日数）
STOCK_ALERT_DAYS=3
# 滞留在庫判定日数
STAGNANT_STOCK_DAYS=30
# 在庫差異アラート閾値（%）
STOCK_DIFF_THRESHOLD=10

# --- タイムゾーン ---
TIMEZONE=Asia/Tokyo
